{
  "name": "piflow",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter piflow-server run start",
    "lint": "eslint . --max-warnings 0 && stylelint 'web/src/**/*.css' --max-warnings 0",
    "lint:fix": "eslint . --fix && stylelint 'web/src/**/*.css' --fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter piflow-server run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@eslint-react/eslint-plugin": "^5.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
